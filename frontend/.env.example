# Frontend build-time config (Vite). Copy to .env for local overrides.
#
# Backend API base URL. The Socket.IO URL is derived from this automatically
# (the "/api/v1" suffix is stripped). One variable configures both.
#
# Local dev (default if unset): http://localhost:5000/api/v1
# Production (set in Render):    https://api.varunaat.in/api/v1
VITE_API_URL=http://localhost:5000/api/v1
