# ─────────────────────────────────────────────
# VARUNA OPS — BACKEND ENVIRONMENT (EXAMPLE)
# Copy to `.env` and fill in real values. NEVER commit the real .env.
# If any real secret was ever committed or shared, ROTATE it (it is
# permanently in git history otherwise).
# ─────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development

# ─────────────────────────────────────────────
# PostgreSQL
# ─────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=varuna_nexus
DB_USER=postgres
DB_PASSWORD=your_database_password_here

# Pool tuning (optional — defaults shown)
# DB_POOL_MAX=10            # connections per process; keep ≤ (server max_connections / 2)
# DB_IDLE_TIMEOUT_MS=8000   # drop idle slot after 8 s (must be < cloud provider's idle timeout)
# DB_CONN_TIMEOUT_MS=15000  # max wait for a free slot when pool is full
# DB_STMT_TIMEOUT_MS=12000  # server-side query kill threshold

# ─────────────────────────────────────────────
# JWT — generate a strong secret: `openssl rand -hex 64`
# JWT_EXPIRES_IN is only a FALLBACK session window. The live value is
# company_config.session_timeout_hours (admin-tunable, default 360h = 15 days),
# which sets both the token expiry and the auth cookie's lifetime.
# ─────────────────────────────────────────────
JWT_SECRET=use_openssl_rand_hex_64_to_generate_one
JWT_EXPIRES_IN=15d

# ─────────────────────────────────────────────
# Cloudflare R2 Bucket (S3-compatible)
# ─────────────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY=your_access_key
R2_SECRET_KEY=your_secret_key
R2_BUCKET=varunaops

# Frontend origin(s) for CORS + socket. Single URL, or comma-separated for
# several (e.g. https://app.varunaat.in,https://varunaat.in). Vite dev = 5173.
FRONTEND_URL=http://localhost:5173

# Public base URL used for the LINKS inside outbound email (welcome, BD
# digests, attendance reminder, weekly report). Must be ONE origin, no trailing
# slash. Falls back to the first origin in FRONTEND_URL when unset.
# Production: APP_URL=https://app.varunaat.in
APP_URL=http://localhost:5173

# Parent domain for the auth cookie in PRODUCTION so login works across the
# app + API subdomains. Leave EMPTY in local dev (localhost is host-only).
# Production example: COOKIE_DOMAIN=.varunaat.in
COOKIE_DOMAIN=

# ─────────────────────────────────────────────
# SMTP (Notifications). Use a provider app-password, never your login password.
# ─────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@example.com
SMTP_PASS=your_app_password
SMTP_FROM_NAME=Varuna Nexus

# ─────────────────────────────────────────────
# Redis (BullMQ queues). OPTIONAL — if unset the app runs in degraded
# synchronous mode (emails/notifications/ZIP run inline, no background workers).
# ─────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379

# ─────────────────────────────────────────────
# Uploads — how long a chunked-upload session stays resumable (hours).
# Default 72h so large field datasets (50–100 GB) on slow links survive.
# ─────────────────────────────────────────────
# UPLOAD_SESSION_HOURS=72
