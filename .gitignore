# ─────────────────────────────────────────────
# VARUNA OPS — ROOT IGNORE
# Protects secrets/artifacts if the repo is initialised at this root.
# ─────────────────────────────────────────────

# Claude Code machine-local settings (may contain local commands/credentials)
.claude/settings.local.json

# Disabled nested git repo (backend was flattened into this monorepo)
**/.git.disabled/

# Backend one-off diagnostic/scratch scripts — contain hardcoded local DB creds,
# not part of the application runtime.
backend/fix-db.js
backend/fix_projects_schema.js
backend/inspect_members.js
backend/inspect_projects.js
backend/read_users.js
backend/reset-passwords.js
backend/simulate_failing_query.js
backend/tmp_check.js

# Dependencies
node_modules/
**/node_modules/

# Secrets — NEVER commit real env files. Only *.example is tracked.
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# Credentials / keys
*.pem
*.key
*.p12
upload-credentials.js
backend/uploads/

# Build output
dist/
build/
**/dist/
**/build/
# Deploy archives — regenerated by frontend/deploy.ps1 on every deploy
frontend/dist.tar.gz
frontend/dist.zip

# Logs & debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS / editor
.DS_Store
Thumbs.db
.idea/
*.suo
*.sw?

# Scratch / generated audit dumps
full_codebase.txt
VARUNA_BACKEND_CONSOLIDATED*
test-results*
backend/scratch/
backend/tmp_*
__pycache__/
*.pyc
